# Exemplo de Variáveis de Ambiente do Aplicativo Agenda Nail Designer
# Copie este arquivo para .env e preencha com suas credenciais reais

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-do-supabase

# Senha mestra do Administrador
VITE_ADMIN_PASSWORD=sua-senha-segura-aqui

# Chaves de Licença do Aplicativo
VITE_LICENSE_KEY_VITALICIO=SUA-CHAVE-VITALICIA
VITE_LICENSE_KEY_MENSAL=SUA-CHAVE-MENSAL

# Sal de integridade (opcional)
VITE_SECURITY_SALT=seu-sal-de-seguranca-customizado
